# Copy to .env and fill in real values for local development.

# Neon Postgres connection string (Dashboard -> Connection Details -> Pooled connection).
# Until this is set, the server boots with a non-functional placeholder and fails to connect.
DATABASE_URL=postgres://username:password@ep-placeholder.us-east-2.aws.neon.tech/foliohub?sslmode=require

# Any long random string. Rotate this and every issued token is invalidated.
JWT_SECRET=devfolio-dev-secret-change-me
JWT_EXPIRY_HOURS=168

PORT=8080

# Comma-separated list of frontend origins allowed to call this API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Required for AI Studio. Without it, /api/ai/generate returns 503.
# Provider is Groq's OpenAI-compatible API. Get a key at https://console.groq.com.
GROQ_API_KEY=
AI_MODEL=openai/gpt-oss-120b